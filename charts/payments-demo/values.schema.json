{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "imagePullSecrets",
    "replicaCount",
    "generator",
    "otel",
    "resources"
  ],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionsPerMinute",
        "paymentTypeWeights",
        "scenarioWeights"
      ],
      "properties": {
        "transactionsPerMinute": {
          "type": "number",
          "minimum": 0,
          "maximum": 600
        },
        "paymentTypeWeights": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(,[0-9]+(\\.[0-9]+)?){3}$",
          "not": {
            "pattern": "^0+(\\.0+)?(,0+(\\.0+)?){3}$"
          }
        },
        "scenarioWeights": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?(,[0-9]+(\\.[0-9]+)?){2}$",
          "not": {
            "pattern": "^0+(\\.0+)?(,0+(\\.0+)?){2}$"
          }
        }
      }
    },
    "otel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "endpoint",
        "headersSecretName",
        "headersSecretKey"
      ],
      "properties": {
        "endpoint": {
          "type": "string",
          "pattern": "^$|^https?://[^\\s]+$"
        },
        "headersSecretName": {
          "type": "string"
        },
        "headersSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object"
        },
        "limits": {
          "type": "object"
        }
      }
    }
  }
}
