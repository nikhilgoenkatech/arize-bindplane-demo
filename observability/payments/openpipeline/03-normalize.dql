fieldsAdd payment.transaction_id = coalesce(toString(transactionId), toString(dt.temp.payment[transactionId])),
  payment.journey_id = coalesce(toString(journeyId), toString(dt.temp.payment[journeyId])),
  payment.type = coalesce(toString(paymentType), toString(dt.temp.payment[paymentType])),
  payment.rail = coalesce(toString(paymentRail), toString(dt.temp.payment[paymentRail])),
  payment.channel = coalesce(toString(channel), toString(dt.temp.payment[channel])),
  payment.customer_segment = coalesce(toString(customerSegment), toString(dt.temp.payment[customerSegment])),
  payment.direction = coalesce(toString(direction), toString(dt.temp.payment[direction])),
  payment.currency = coalesce(toString(currency), toString(dt.temp.payment[currency])),
  payment.amount = coalesce(toDouble(amount), toDouble(dt.temp.payment[amount])),
  payment.scenario = coalesce(toString(scenario), toString(dt.temp.payment[scenario])),
  payment.service = coalesce(toString(service), toString(dt.temp.payment[service])),
  payment.stage = coalesce(toString(stage), toString(dt.temp.payment[stage])),
  payment.status = coalesce(toString(status), toString(dt.temp.payment[status])),
  payment.event_type = coalesce(toString(eventType), toString(dt.temp.payment[eventType])),
  payment.step_sequence = coalesce(toLong(stepSequence), toLong(dt.temp.payment[stepSequence])),
  payment.stage_duration_ms = coalesce(toDouble(durationMs), toDouble(dt.temp.payment[durationMs])),
  payment.total_duration_ms = coalesce(toDouble(totalDurationMs), toDouble(dt.temp.payment[totalDurationMs])),
  payment.risk_score = coalesce(toLong(riskScore), toLong(dt.temp.payment[riskScore])),
  payment.fraud_decision = coalesce(toString(fraudDecision), toString(dt.temp.payment[fraudDecision])),
  payment.error_code = coalesce(toString(errorCode), toString(dt.temp.payment[errorCode])),
  payment.error_message = coalesce(toString(errorMessage), toString(dt.temp.payment[errorMessage])),
  payment.trace_id = coalesce(toString(trace_id), toString(dt.temp.payment[trace_id])),
  payment.span_id = coalesce(toString(span_id), toString(dt.temp.payment[span_id])),
  payment.source_timestamp = toString(coalesce(toTimestamp(dt.temp.payment[timestamp]), toTimestamp(timestamp)))
| fieldsAdd transactionId = coalesce(transactionId, dt.temp.payment[transactionId]), journeyId = coalesce(journeyId, dt.temp.payment[journeyId]), trace_id = coalesce(trace_id, dt.temp.payment[trace_id]), span_id = coalesce(span_id, dt.temp.payment[span_id])
