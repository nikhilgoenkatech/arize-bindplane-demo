fieldsAdd demo.name = "synthetic-payments-demo", demo.schema_version = "1", payment.raw_content = content, payment.quality.parse_attempted = isNotNull(content) and (isNull(transactionId) or isNull(journeyId) or isNull(paymentType) or isNull(paymentRail) or isNull(channel) or isNull(customerSegment) or isNull(direction) or isNull(currency) or isNull(amount) or isNull(scenario) or isNull(service) or isNull(stage) or isNull(status) or isNull(stepSequence) or isNull(durationMs) or isNull(trace_id) or isNull(span_id) or (stage == "PAYMENT_COMPLETED" and (isNull(totalDurationMs) or isNull(eventType))))
