# DO NOT PUSH CHANGES OF THIS FILE TO opentelemetry/opentelemetry-demo
# PLACE YOUR .env ENVIRONMENT VARIABLES OVERRIDES IN THIS FILE

# Rootless podman: use the podman Docker-compatible API socket so the collector's
# docker resource detector and docker_stats receiver can connect.
# DOCKER_SOCK=/run/user/1000/podman/podman.sock

# =============================================================================
# LLM / Chatbot Configuration
# =============================================================================
# Swap LLM_MODEL to demonstrate "bad model vs good model" — no code changes needed.
# Just change the value and run: docker compose up -d chatbot
#
# "Bad" model (cheap, lower quality):
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-3.5-turbo
# "Good" model (swap in for the after state):
# LLM_MODEL=gpt-4o
#
# Your LLM API key:
API_KEY=<replace-with-your-api-key>
#
# Disable VCR cache so every demo request hits the real LLM:
USE_VCR=False

# =============================================================================
# BindPlane Agent — OTel collector forwards here, BindPlane routes onward
# =============================================================================
BINDPLANE_AGENT_HOST=bindplane-agent
BINDPLANE_AGENT_PORT_GRPC=4317

# =============================================================================
# Arize — LLM/AI observability for the chatbot agent (traces only)
# Get Space ID and API key from app.arize.com → Settings → API Keys
# =============================================================================
ARIZE_SPACE_ID=<replace-with-space-id>
ARIZE_API_KEY=<replace-with-api-key>
ARIZE_PROJECT_NAME=otel-demo-chatbot
